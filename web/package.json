{
  "name": "frontend-web",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@types/jest": "^24.0.0",
    "@types/node": "^12.0.0",
    "@types/react": "^16.9.0",
    "@types/react-dom": "^16.9.0",
    "@unform/core": "^2.1.3",
    "@unform/web": "^2.1.3",
    "axios": "^0.20.0",
    "clsx": "^2.1.1",
    "date-fns": "^2.16.1",
    "moment": "^2.30.1",
    "react": "^16.13.1",
    "react-big-calendar": "^1.19.4",
    "react-day-picker": "^7.4.8",
    "react-dom": "^16.13.1",
    "react-icons": "^3.11.0",
    "react-router-dom": "^5.2.0",
    "react-scripts": "3.4.3",
    "react-spring": "^8.0.27",
    "tailwind-merge": "^3.6.0",
    "typescript": "3.8",
    "uuid": "^8.3.1",
    "yup": "^0.29.3"
  },
  "scripts": {
    "start": "cross-env NODE_OPTIONS=--openssl-legacy-provider ./node_modules/@craco/craco/bin/craco.js start",
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider ./node_modules/@craco/craco/bin/craco.js build",
    "test": "cross-env NODE_OPTIONS=--openssl-legacy-provider ./node_modules/@craco/craco/bin/craco.js test --env jest-environment-jsdom-fourteen",
    "test:coverage": "cross-env NODE_OPTIONS=--openssl-legacy-provider ./node_modules/@craco/craco/bin/craco.js test --env jest-environment-jsdom-fourteen --coverage --watchAll false",
    "eject": "react-scripts eject"
  },
  "jest": {
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "src/pages/**/*.tsx",
      "src/components/**/*.tsx",
      "src/hooks/*.tsx",
      "!src/hooks/index.tsx"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "postcss": "8.5.23"
  },
  "devDependencies": {
    "@craco/craco": "^5.9.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^11.2.7",
    "@testing-library/react-hooks": "^7.0.2",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-router": "^5.1.17",
    "@types/react-router-dom": "^5.1.6",
    "@types/uuid": "^8.3.0",
    "@types/yup": "^0.29.8",
    "@typescript-eslint/eslint-plugin": "^4.3.0",
    "@typescript-eslint/parser": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "axios-mock-adapter": "^1.19.0",
    "cross-env": "^10.1.0",
    "eslint": "6.8.0",
    "eslint-config-airbnb": "^18.2.0",
    "eslint-config-prettier": "^6.12.0",
    "eslint-import-resolver-typescript": "^2.3.0",
    "eslint-plugin-import": "^2.20.1",
    "eslint-plugin-jsx-a11y": "^6.2.3",
    "eslint-plugin-prettier": "^3.1.4",
    "eslint-plugin-react": "^7.19.0",
    "eslint-plugin-react-hooks": "^2.5.0",
    "postcss": "8.5.23",
    "prettier": "^2.1.2",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7"
  }
}

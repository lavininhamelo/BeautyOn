{
  "dependencies": {
    "@prisma/adapter-mariadb": "^6.19.3",
    "@prisma/client": "^6.8.1",
    "@sentry/node": "10.50.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "handlebars": "^4.7.8",
    "jose": "^4.15.5",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.1",
    "prisma": "^6.8.1",
    "youch": "^4.1.1",
    "zod": "^3.25.76"
  },
  "scripts": {
    "build": "prisma generate && tsc && npm run copy:views",
    "copy:views": "mkdir -p dist/app/Views && cp -R src/app/Views/. dist/app/Views/",
    "start": "node dist/server.js",
    "dev": "sh -c \"tsc -w --preserveWatchOutput & TSC_PID=$!; while [ ! -f dist/server.js ]; do sleep 0.2; done; node --watch dist/server.js; kill $TSC_PID\"",
    "dev:debug": "sh -c \"tsc -w --preserveWatchOutput & TSC_PID=$!; while [ ! -f dist/server.js ]; do sleep 0.2; done; node --inspect --watch dist/server.js; kill $TSC_PID\"",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "set-provider": "node scripts/set-provider.mjs",
    "docker:up": "docker compose up -d",
    "docker:infra": "docker compose up -d mysql mailhog",
    "docker:logs:app": "docker compose logs -f app"
  },
  "name": "BeautyOn",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "repository": "https://github.com/lavininhamelo/BeautyOn.git",
  "author": "Lavínia <lavininhamelo@hotmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.12.2",
    "@types/nodemailer": "^8.0.0",
    "sucrase": "^3.35.1",
    "typescript": "^5.9.3"
  }
}
